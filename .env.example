# CityFix India — copy to .env and fill values if you have them.
# Maps work without a key via OpenStreetMap + Nominatim (India-restricted).

PORT=5000

# Optional Google Maps Geocoding key (server-side only; never sent to the browser).
# Create a key with Geocoding API enabled and restrict it to your server IP.
GOOGLE_MAPS_API_KEY=

# nominatim (default, no key) or google (requires GOOGLE_MAPS_API_KEY)
MAP_PROVIDER=nominatim

# Default map centre
DEFAULT_CITY=New Delhi
DEFAULT_LAT=28.6139
DEFAULT_LNG=77.2090
DEFAULT_ZOOM=12
